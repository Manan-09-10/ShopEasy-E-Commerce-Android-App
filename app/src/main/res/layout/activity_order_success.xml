<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F1F3F6">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order Placed Successfully!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2874F0"/>

    <TextView
        android:id="@+id/txtOrderId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order ID : ORD1001"
        android:textSize="18sp"
        android:layout_marginTop="15dp"
        android:textColor="#000000"/>

    <TextView
        android:id="@+id/txtDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01 Aug 2026 | 12:30 PM"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:textColor="#000000"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thank you for shopping with ShopEasy.\nYour order has been placed successfully."
        android:layout_marginTop="20dp"
        android:textSize="18sp"
        android:textColor="#000000"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnHome"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Back to Home"
        android:layout_marginTop="30dp"
        android:background="@drawable/button_bg"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="18sp"/>

</LinearLayout>